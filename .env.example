# CodeEcho Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
# Comma-separated allowed origins (supports * or specific domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000

# Production Unified Frontend Serving (serves built React SPA from FastAPI)
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=./frontend/dist

# Database
# For SQLite (default):
DATABASE_URL=sqlite:///./codeecho.db
# For Production Persistent Volume:
# DATABASE_URL=sqlite:////app/data/codeecho.db
# For PostgreSQL (e.g., Supabase / Neon / Render Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/codeecho

# Repository Mining Limits
MAX_COMMITS_DEFAULT=100
MAX_COMMITS_HARD_LIMIT=500
MAX_FILE_SIZE_BYTES=204800
CLONE_TIMEOUT_SECONDS=60
TEMP_DIR_ROOT=./temp_clones

# AI Explanations & LLM Provider
# (Optional: system provides robust deterministic fallback via codeecho-rule-engine-v1 if unset)
EXPLANATION_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Representation & Embeddings
DEFAULT_EMBEDDER=tfidf
EMBEDDING_BATCH_SIZE=32
