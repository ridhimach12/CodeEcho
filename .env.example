# CodeEcho Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./codeecho.db

# Repository Mining Limits
MAX_COMMITS_DEFAULT=100
MAX_FILE_SIZE_BYTES=204800
CLONE_TIMEOUT_SECONDS=60
TEMP_DIR_ROOT=./temp_clones

# AI Explanations (Optional: system provides deterministic fallback if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=
EXPLANATION_PROVIDER=fallback

# Embeddings
DEFAULT_EMBEDDER=tfidf
EMBEDDING_BATCH_SIZE=32
